    "tauri:build:exe": "tauri build --no-bundle",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@tauri-apps/api": "~2.11.0",
